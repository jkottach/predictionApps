# Copy to .env for local dev (gitignored)
VITE_API_URL=/api

# Tenant: fcc | mandrake (or use npm run dev:fcc / dev:mandrake)
VITE_TENANT=fcc

# Local: Google button + JWT (default)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Per-tenant modes: see .env.fcc and .env.mandrake, or:
#   npm run dev:fcc
#   npm run dev:mandrake
#   npm run build:fcc
#   npm run build:mandrake
