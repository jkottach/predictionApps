# Copy to api/.env.fcc on EC2 (not committed). Same MongoDB cluster, FCC database.
# Replace EC2_IP_DASHED with your Elastic IP (dots → dashes, e.g. 203-0-113-10).

PORT=5001
NODE_ENV=production

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fifaPredictionFcc

JWT_SECRET=change_to_long_random_secret
JWT_EXPIRE=7d

GOOGLE_CLIENT_ID=your-fcc-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

FRONTEND_URL=https://fcc.EC2_IP_DASHED.sslip.io

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
